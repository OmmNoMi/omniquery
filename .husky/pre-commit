#!/bin/sh
set -e

echo "=========================================================="
echo "[TDD++ Pre-Commit Gate] Verifying local test suite..."
echo "=========================================================="

# 1. Zero-Glyph & No-Emoji Policy Verification
echo "[1/3] Running Zero-Glyph & No-Emoji Guard..."
python3 scripts/check_no_glyphs.py

# 2. Run Vitest frontend test suite
echo "[2/3] Running Vitest frontend specs..."
yarn test

# 3. Run Frappe backend test suite if bench environment is present
if command -v bench >/dev/null 2>&1; then
    SITE_NAME="${FRAPPE_SITE:-ommnomi.local}"
    if [ -d "../../sites/$SITE_NAME" ]; then
        echo "[3/3] Running Frappe backend unit specs on $SITE_NAME..."
        (cd ../.. && bench --site "$SITE_NAME" run-tests --app omniquery)
    elif [ -d "sites/$SITE_NAME" ]; then
        echo "[3/3] Running Frappe backend unit specs on $SITE_NAME..."
        bench --site "$SITE_NAME" run-tests --app omniquery
    else
        echo "[INFO] Site $SITE_NAME not detected in parent directory; skipping bench tests."
    fi
else
    echo "[INFO] Bench CLI not detected in current PATH; skipping Frappe tests."
fi

echo "=========================================================="
echo "[SUCCESS] All pre-commit test gates passed! Proceeding with commit."
echo "=========================================================="
